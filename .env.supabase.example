# Copiar como .env.local en la raiz. Sirve para npm run dev y npm run build.
# En Cloudflare, configurar esta misma variable en el entorno de build.
# URL publica: no requiere claves para la funcion publica api.
# Las variables VITE_* llegan al navegador. Nunca agregar secretos aqui.
VITE_API_BASE_URL=https://oiipswlnxbcgfflqnlid.supabase.co/functions/v1/api
# Solicitudes de contacto (sin fecha/hora), luego de desplegar booking.
VITE_BOOKING_API_BASE_URL=https://oiipswlnxbcgfflqnlid.supabase.co/functions/v1/booking
# Site key PUBLICA de Turnstile. El secret key va exclusivamente en Supabase Secrets.
VITE_TURNSTILE_SITE_KEY=
