# Solo Supabase Secrets/backend. No copiar estas variables al frontend.
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY son provistas por Supabase Edge Runtime.
# Origenes exactos separados por coma, sin barra final ni comodines.
BOOKING_ALLOWED_ORIGINS=
# Secreto del widget Turnstile configurado para los hostnames permitidos.
TURNSTILE_SECRET_KEY=
# Secreto aleatorio de al menos 32 caracteres para HMAC de telefonos.
BOOKING_RATE_LIMIT_SECRET=
# WhatsApp Business Cloud API (solo backend). Plantillas aprobadas por Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_CENTER_PHONE=
WHATSAPP_PATIENT_TEMPLATE=
WHATSAPP_CENTER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
# Secreto aleatorio de al menos 32 caracteres, tambien en Vault para el cron.
CONTACT_WORKER_SECRET=
